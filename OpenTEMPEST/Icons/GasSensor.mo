within OpenTEMPEST.Icons;
partial model GasSensor "Icon for gas sensors in the flow path"
  annotation (Icon(graphics={Rectangle(extent={{-100,20},{100,-20}},lineColor={128,128,128},fillColor={159,159,223},fillPattern=FillPattern.Solid),Ellipse(extent={{-30,60},{30,0}},lineColor={0,0,0},fillColor={255,255,255},fillPattern=FillPattern.Solid),Text(extent={{-100,-30},{100,-60}},textString="%name",lineColor={0,0,0})}));
end GasSensor;
