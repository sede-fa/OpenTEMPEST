within OpenTEMPEST.Icons;
partial model Fan "Icon for fans and compressors"
  annotation (Icon(graphics={Ellipse(extent={{-60,60},{60,-60}},lineColor={128,128,128},fillColor={159,159,223},fillPattern=FillPattern.Solid),Polygon(points={{-30,40},{-30,-40},{50,0},{-30,40}},lineColor={128,128,128},fillColor={255,255,255},fillPattern=FillPattern.Solid),Text(extent={{-100,-70},{100,-100}},textString="%name",lineColor={0,0,0})}));
end Fan;
