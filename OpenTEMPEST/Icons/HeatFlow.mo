within OpenTEMPEST.Icons;
partial model HeatFlow "Icon for heat flow components"
  annotation (Icon(graphics={Rectangle(extent={{-100,100},{100,-100}},lineColor={0,0,0},fillColor={255,255,255},fillPattern=FillPattern.Solid),Rectangle(extent={{-60,30},{60,-30}},lineColor={255,127,0},fillColor={255,127,0},fillPattern=FillPattern.Solid),Text(extent={{-100,-110},{100,-140}},textString="%name",lineColor={0,0,0})}));
end HeatFlow;
