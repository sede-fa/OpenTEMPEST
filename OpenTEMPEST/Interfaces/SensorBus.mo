within OpenTEMPEST.Interfaces;
expandable connector SensorBus "Empty bus connector that is expanded by the signals connected to it"
  annotation (Icon(graphics={Polygon(
          points={{-100,100},{100,100},{100,-100},{-100,-100},{-100,100}},
          lineColor={255,170,213},
          fillColor={127,0,127},
          fillPattern=FillPattern.Solid)}));
end SensorBus;
